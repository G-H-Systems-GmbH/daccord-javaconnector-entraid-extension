<?xml version="1.0" encoding="UTF-8"?>
<!--
    modifyAccountStatus - enables or disables a user (PATCH /users/{id}).

    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> modifyaccountstatus examples/gpconnect.xml examples/account-status.xml

    <parameters> are identifiers and steering values (pp_config_<name> in the extension),
    <attributes> are written to Microsoft Graph as they are (pp_data_<name>).
-->
<provisioning>
    <data>
        <attributes>
            <attribute name="accountEnabled">
                <value>false</value>
            </attribute>
        </attributes>
    </data>
    <parameters>
        <parameter name="accountuniqueid">YOUR_USER_OBJECT_ID</parameter>
        <!-- Optional:
        <parameter name="syncedaccount_policy">skipattributes</parameter>  a synced account is refused unless "ignore"
        <parameter name="syncenabled">false</parameter>  sync state as collected; only used if Graph cannot be asked
        -->
    </parameters>
</provisioning>
