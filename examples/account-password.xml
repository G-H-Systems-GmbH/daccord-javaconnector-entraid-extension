<?xml version="1.0" encoding="UTF-8"?>
<!--
    modifyAccountPassword - sets a new password (PATCH /users/{id}).

    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> modifyaccountpassword examples/gpconnect.xml examples/account-password.xml

    <parameters> are identifiers and steering values (pp_config_<name> in the extension),
    <attributes> are written to Microsoft Graph as they are (pp_data_<name>).

    daccord sends the password encrypted (type="password"); in this test it may be clear text.
-->
<provisioning>
    <data>
        <attributes>
            <attribute name="PASSWORD">
                <value>YOUR_NEW_PASSWORD</value>
            </attribute>
        </attributes>
    </data>
    <parameters>
        <parameter name="accountuniqueid">YOUR_USER_OBJECT_ID</parameter>
        <!-- Optional:
        <parameter name="forcechangepasswordnextsignin">true</parameter>  the user has to change the password at the next sign-in
        -->
    </parameters>
</provisioning>
