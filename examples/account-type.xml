<!--
    modifyAccountType - changes the userType (PATCH /users/{id}).

    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> modifyaccounttype examples/gpconnect.xml examples/account-type.xml

    <parameters> are identifiers and steering values (pp_config_<name> in the extension),
    <attributes> are written to Microsoft Graph as they are (pp_data_<name>).

    accounttype is the Entra ID userType: Member | Guest.
-->
<provisioning>
    <data>
        <attributes>
        </attributes>
    </data>
    <parameters>
        <parameter name="accountuniqueid">YOUR_USER_OBJECT_ID</parameter>
        <parameter name="accounttype">Guest</parameter>
    </parameters>
</provisioning>
