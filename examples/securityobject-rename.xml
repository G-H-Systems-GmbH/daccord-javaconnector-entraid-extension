    <data>
        <attributes>
        </attributes>
    </data>
    <parameters>
        <parameter name="securityobjectuniqueid">YOUR_GROUP_OBJECT_ID</parameter>
        <parameter name="securityobjectname">New name</parameter>
    </parameters>
</provisioning>
